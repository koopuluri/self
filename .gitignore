# Local state, credentials, and generated builds.
.DS_Store
.obsidian/
.ghost/
.env
.env.*
!.env.example
.vercel/
node_modules/
.next/
out/
dist/
build/
.build/
.swiftpm/
__pycache__/
*.pyc
*.tsbuildinfo
.venv/
.aws/
.codex/
*.pem
*.key

# Media bytes live in R2; Git tracks their restoration manifest.
/<3/assets/*
!/<3/assets/README.md
!/<3/assets/manifest.json
/*.png
/*.jpg
/*.jpeg
/*.heic
/*.heif
/*.webp
/*.gif
/*.mp4
/*.mov
/*.mp3
/*.m4a
/*.wav
/*.pdf
/*.blend

# Lens taste media is backed up only by the publication workflow.
/<3/taste/**/*.png
/<3/taste/**/*.m4a
/<3/taste/.draft-*/

# Local π execution state; durable memory remains ordinary workspace material.
/π/.runtime/
/π/threads/
/π/logs/
/π/chats/*.json

# Local inbox polling cursors.
/<3/inbox/state/
