# Local state, credentials, and generated builds.
.DS_Store
.obsidian/
.ghost/
.env
.env.*
!.env.example
.vercel/
node_modules/
.next/
out/
dist/
build/
.build/
.swiftpm/
__pycache__/
*.pyc
*.tsbuildinfo
.venv/
.aws/
.codex/
*.pem
*.key

# Media bytes live in R2; Git tracks their restoration manifest.
/<3/stream/assets/*
!/<3/stream/assets/README.md
!/<3/stream/assets/manifest.json
/*.png
/*.jpg
/*.jpeg
/*.heic
/*.heif
/*.webp
/*.gif
/*.mp4
/*.mov
/*.mp3
/*.m4a
/*.wav
/*.pdf
/*.blend

# Lens taste media is backed up only by the publication workflow.
/<3/stream/taste/**/*.png
/<3/stream/taste/**/*.m4a
/<3/stream/taste/.draft-*/

# Local π execution state; durable memory remains ordinary workspace material.
/π/.runtime/
/π/threads/*
!/π/threads/README.md
/π/logs/*
!/π/logs/README.md
/π/chats/*.json

# Local inbox polling cursors.
/<3/stream/inbox/state/

# Local compatibility paths used by pre-migration desktop releases.
/<3/products
/<3/notes
/<3/assets
